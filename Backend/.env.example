# PostgreSQL/PostGIS
VEZLIST_DB_NAME=vezlist
VEZLIST_DB_URL=jdbc:postgresql://localhost:5433/vezlist
VEZLIST_DB_USERNAME=vezlist
# Local-only development password. Replace it in any shared, staging, or production environment.
VEZLIST_DB_PASSWORD=vezlist

# Comma-separated browser origins allowed to call /api. Both localhost and
# 127.0.0.1 variants are listed since browsers treat them as different
# origins even though they resolve to the same machine — a dev opening the
# app via one or the other should not see every API call fail as a CORS
# error that looks, to `fetch`, identical to the backend being down.
VEZLIST_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://localhost:3101,http://localhost:3102,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Beyond the exact list above, also accept any http://localhost:*,
# http://127.0.0.1:*, or private-LAN-IP origin regardless of port — covers a
# dev opening the app via the Next.js "Network:" URL, a different port, or
# any other same-machine origin the exact list didn't happen to name.
# Disabled by default in application.yml; this local example opts in. Keep
# false in real deployments.
VEZLIST_CORS_ALLOW_LOCAL_PATTERNS=true

# Module 5 object storage. Never commit a real storage credential.
VEZLIST_STORAGE_ENDPOINT=http://localhost:9000
VEZLIST_STORAGE_REGION=us-east-1
VEZLIST_STORAGE_BUCKET=vezlist-media
VEZLIST_STORAGE_ACCESS_KEY=replace-me
VEZLIST_STORAGE_SECRET_KEY=replace-me
VEZLIST_STORAGE_UPLOAD_URL_TTL=PT10M
VEZLIST_STORAGE_DOWNLOAD_URL_TTL=PT15M
VEZLIST_STORAGE_MAX_IMAGE_BYTES=10485760

# Local MinIO administration credentials. Use different values in every environment.
VEZLIST_MINIO_ROOT_USER=vezlist-minio
VEZLIST_MINIO_ROOT_PASSWORD=replace-with-a-long-local-secret

# Module 6 discovery query guardrail.
VEZLIST_DISCOVERY_QUERY_TIMEOUT_MS=3000

# Admin console seeding (cc.vezlist.identity.application.AdminAccountSeeder).
# Local development only. Set true and provide a unique password of at least
# 12 characters to create admin@vezlist.cc. Keep disabled elsewhere.
VEZLIST_SEED_ADMIN=false
VEZLIST_SEED_ADMIN_PASSWORD=

# Local story testing: publish paid packs without taking payment.
VEZLIST_STORY_DEMO_PURCHASES_ENABLED=false

# Live sessions: creator checkout can be demonstrated without a payment gateway.
# Watching is always free. Use a separate Gcore development account/token for testing.
VEZLIST_LIVE_DEMO_PURCHASES_ENABLED=false
# Server-side API token with Streaming read/write permissions.
# Streams always use auto_record=false and dvr_enabled=false (no recording or rewind).
VEZLIST_GCORE_API_TOKEN=
VEZLIST_FFMPEG_PATH=ffmpeg
VEZLIST_REDIS_HOST=localhost
VEZLIST_REDIS_PORT=6379
VEZLIST_REDIS_PASSWORD=
VEZLIST_LIVE_BROADCAST_WS_URL=ws://localhost:8080/api/v1/live/broadcast
VEZLIST_LIVE_CHAT_WS_URL=ws://localhost:8080/api/v1/live/chat
# Capacity limits protect this API process. Increase only after representative load testing.
VEZLIST_LIVE_MAX_BROADCASTS_PER_NODE=4
VEZLIST_LIVE_MAX_CHAT_CONNECTIONS_PER_NODE=2000
