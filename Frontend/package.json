{
  "name": "vezlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vezlist/marketplace",
    "dev:personals": "npm run dev -w @vezlist/personals",
    "dev:admin": "npm run dev -w @vezlist/admin",
    "build": "npm run build -w @vezlist/marketplace",
    "build:personals": "npm run build -w @vezlist/personals",
    "build:admin": "npm run build -w @vezlist/admin",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start -w @vezlist/marketplace",
    "start:personals": "npm run start -w @vezlist/personals",
    "start:admin": "npm run start -w @vezlist/admin",
    "preview": "npm run preview -w @vezlist/marketplace",
    "preview:personals": "npm run preview -w @vezlist/personals",
    "preview:admin": "npm run preview -w @vezlist/admin",
    "deploy": "npm run deploy -w @vezlist/marketplace",
    "deploy:personals": "npm run deploy -w @vezlist/personals",
    "deploy:admin": "npm run deploy -w @vezlist/admin",
    "deploy:all": "npm run deploy && npm run deploy:personals && npm run deploy:admin",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test",
    "test:components": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
