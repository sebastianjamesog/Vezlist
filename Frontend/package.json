{
  "name": "vezlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vezlist/marketplace",
    "dev:personals": "npm run dev -w @vezlist/personals",
    "build": "npm run build -w @vezlist/marketplace",
    "build:personals": "npm run build -w @vezlist/personals",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start -w @vezlist/marketplace",
    "start:personals": "npm run start -w @vezlist/personals",
    "preview": "npm run preview -w @vezlist/marketplace",
    "preview:personals": "npm run preview -w @vezlist/personals",
    "deploy": "npm run deploy -w @vezlist/marketplace",
    "deploy:personals": "npm run deploy -w @vezlist/personals",
    "deploy:all": "npm run deploy && npm run deploy:personals",
    "test": "node --test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.125.0"
  }
}
