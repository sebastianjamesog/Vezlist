# Copy to .env.local for a local override — .env.local is gitignored and Next
# layers it over .env.production, so you don't need to edit the committed file
# to point a local build at different origins.
#
# These three are NEXT_PUBLIC_*, so Next inlines them at build time: changing
# them means `npm run build` / `next dev` again, not just a reload. All three
# are public hostnames, never secrets — see apps/admin/.env.production, which
# commits the live values on purpose. The console links out to both boards
# (the rail's "Open site" links, the note on /settings) and its own URL is
# what `metadataBase` resolves against. The first real secret this app gets
# should go in .env.local, never here.
NEXT_PUBLIC_MARKETPLACE_URL=https://vezlist-new-marketplace.vezlistofficial.workers.dev
NEXT_PUBLIC_PERSONALS_URL=https://vezlist-new-personals.vezlistofficial.workers.dev
NEXT_PUBLIC_ADMIN_URL=https://vezlist-new-admin.vezlistofficial.workers.dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Error tracking (#20). Left unset here on purpose: with no DSN the six error
# boundaries and `instrumentation.js` still log a structured line, which is
# what Cloudflare Workers Logs collect. Setting one adds the *client* half —
# a component that throws in the browser never reaches the Worker. A DSN is a
# public value designed to ship in a client bundle, so it is not a secret; it
# is read at build time, so set it before `npm run deploy`, not after.
# See DEPLOY.md § Error tracking.
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@<org>.ingest.sentry.io/<projectId>
# NEXT_PUBLIC_ENVIRONMENT=production
