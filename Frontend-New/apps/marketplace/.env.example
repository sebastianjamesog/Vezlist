# Copy to .env.local for a local override — .env.local is gitignored and Next
# layers it over .env.production, so you don't need to edit the committed file
# to point a local build at different origins.
#
# These two are NEXT_PUBLIC_*, so Next inlines them at build time: changing
# them means `npm run build` / `next dev` again, not just a reload. Both are
# public hostnames, never secrets — see apps/marketplace/.env.production,
# which commits the live values on purpose. The first real secret this app
# gets should go in .env.local, never here.
NEXT_PUBLIC_MARKETPLACE_URL=https://vezlist-new-marketplace.vezlistofficial.workers.dev
NEXT_PUBLIC_PERSONALS_URL=https://vezlist-new-personals.vezlistofficial.workers.dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Error tracking (#20). Left unset here on purpose: with no DSN the six error
# boundaries and `instrumentation.js` still log a structured line, which is
# what Cloudflare Workers Logs collect. Setting one adds the *client* half —
# a component that throws in the browser never reaches the Worker. A DSN is a
# public value designed to ship in a client bundle, so it is not a secret; it
# is read at build time, so set it before `npm run deploy`, not after.
# See DEPLOY.md § Error tracking.
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@<org>.ingest.sentry.io/<projectId>
# NEXT_PUBLIC_ENVIRONMENT=production

# Paybis — the checkout behind Buy credits (packages/shared/src/server/paybisRequest.js).
#
# None of these are NEXT_PUBLIC_: they are read by the route handler at
# request time, never inlined into the bundle, so changing one is a redeploy
# and not a rebuild. PAYBIS_API_KEY is a real secret — it belongs in
# .env.local for a local run and in `wrangler secret put` for a deploy, never
# in this file or in .env.production.
#
# With PAYBIS_API_KEY unset the route answers `{ configured: false }` and the
# buy-credits modal says so in as many words instead of opening a checkout it
# cannot complete. That is the state every deploy of this repo is in until a
# merchant account exists, and it is a supported one.
#
# PAYBIS_ENVIRONMENT defaults to `sandbox`, and only the exact string
# `production` moves it — a typo cannot start charging real cards.
# PAYBIS_API_KEY=
# PAYBIS_SECRET_KEY=          # enables X-Signature; confirm the preimage with Paybis first
# PAYBIS_ENVIRONMENT=sandbox
# PAYBIS_FIAT_CURRENCY=USD
# PAYBIS_CRYPTO_CURRENCY=USDT-TRC20
# PAYBIS_PAYMENT_METHOD=credit_card
# PAYBIS_RETURN_ORIGIN=       # only when the public origin isn't the request's
